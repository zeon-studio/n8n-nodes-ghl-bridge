{
  "name": "n8n-nodes-ghl-bridge",
  "version": "1.4.1",
  "description": "GoHighLevel Token Broker integration",
  "author": "Zeon Studio <zeonstudiohq@gmail.com> (https://zeon.studio)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeon-studio/n8n-nodes-ghl-bridge.git"
  },
  "homepage": "https://github.com/zeon-studio/n8n-nodes-ghl-bridge#readme",
  "bugs": {
    "url": "https://github.com/zeon-studio/n8n-nodes-ghl-bridge/issues"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "lint": "eslint \"credentials/**/*.ts\" \"nodes/**/*.ts\"",
    "prerelease": "git add -A && git diff --cached --quiet || git commit -m 'chore: release prep'",
    "release-patch": "npm run prerelease && npm version patch && git push && git push --tags",
    "release-minor": "npm run prerelease && npm version minor && git push && git push --tags",
    "release-major": "npm run prerelease && npm version major && git push && git push --tags"
  },
  "keywords": [
    "n8n-community-node-package"
  ],
  "files": [
    "dist"
  ],
  "dependencies": {
    "n8n-core": "^2.16.1",
    "n8n-workflow": "^2.16.0"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.32.1",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "tslint": "^6.1.3",
    "typescript": "^5.5.0"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GhlBridgeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GhlBridge/GhlBridge.node.js",
      "dist/nodes/GhlBridgeTrigger/GhlBridgeTrigger.node.js"
    ]
  }
}
