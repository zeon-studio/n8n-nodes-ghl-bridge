{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "removeComments": false
  },
  "include": ["index.ts", "credentials/**/*.ts", "nodes/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
